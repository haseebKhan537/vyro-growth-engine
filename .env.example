APP_NAME=Vyro Growth Engine
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://vyro:vyro@localhost:5432/vyro_growth
OUTBOUND_ENABLED=false
OUTBOUND_HALTED=false
LOG_LEVEL=INFO
NPPES_API_BASE_URL=https://npiregistry.cms.hhs.gov/api/
NPPES_TIMEOUT_SECONDS=10
NPPES_MAX_RETRIES=3
NPPES_RETRY_BACKOFF_SECONDS=0.5
DISCOVERY_MAX_RECORDS_PER_RUN=500
INTERNAL_API_KEY=
WEBSITE_FETCH_TIMEOUT_SECONDS=8
WEBSITE_FETCH_MAX_BYTES=524288
WEBSITE_FETCH_MAX_REDIRECTS=3
WEBSITE_MAX_PAGES_PER_ORG=5
WEBSITE_RATE_LIMIT_SECONDS=0.5
WEBSITE_USER_AGENT=VyroGrowthEngine/0.1 (+https://github.com/haseebKhan537/vyro-growth-engine)
# Paid decision-maker enrichment is not wired. CI and local runs use the stub
# provider, which never calls a live API and never invents contacts.
# A future live adapter would require a purchased provider key, for example:
# CONTACT_ENRICHMENT_API_KEY=
# CONTACT_ENRICHMENT_API_BASE_URL=
# Live OpenAI personalization is disabled by default. CI and local development
# use the deterministic stub. Tests never require a live key. Enable only with
# an explicit flag; this still does not send email, place calls, or enroll leads.
OPENAI_PERSONALIZATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_PERSONALIZATION_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BACKOFF_SECONDS=0.5
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_MAX_INPUT_TOKENS=4000
# Placeholder only; live cost enforcement is not implemented.
# OPENAI_ESTIMATED_COST_USD_LIMIT=
# Live Smartlead enrollment is not wired. CI and local development use the
# deterministic stub, which never sends email and never enrolls a live campaign.
# Tests never require a live key. SMARTLEAD_LIVE_ENABLED remains false; Phase 6
# does not open a default HTTP session even if this flag is flipped.
SMARTLEAD_LIVE_ENABLED=false
SMARTLEAD_API_KEY=
# Future live adapter base URL (unused in Phase 6):
# SMARTLEAD_API_BASE_URL=
SMARTLEAD_TIMEOUT_SECONDS=10
SMARTLEAD_MAX_RETRIES=3
SMARTLEAD_RETRY_BACKOFF_SECONDS=0.5
# Live OpenAI reply classification is disabled by default. CI and local
# development use the deterministic rule stub. Tests never require a live key.
# Enable only with an explicit flag; this still does not send email, place
# calls, book meetings, or enroll leads.
OPENAI_REPLY_CLASSIFICATION_ENABLED=false
# Live Google Calendar / Meet booking is not wired. CI and local development
# use the deterministic stub, which never creates calendar events or Meet
# links. Tests never require a live key. GOOGLE_CALENDAR_LIVE_ENABLED remains
# false; Phase 8 does not open a default HTTP session even if this flag is
# flipped.
GOOGLE_CALENDAR_LIVE_ENABLED=false
GOOGLE_CALENDAR_API_KEY=
# Future live adapter base URL (unused in Phase 8):
# GOOGLE_CALENDAR_API_BASE_URL=
GOOGLE_CALENDAR_TIMEOUT_SECONDS=10
GOOGLE_CALENDAR_MAX_RETRIES=3
GOOGLE_CALENDAR_RETRY_BACKOFF_SECONDS=0.5
